# YOUTUBE_API_KEY: Required for official YouTube Data API v3 video search, discovery, and caption metadata in LingoSphere Videos.
# Configure your YouTube Data API v3 key from Google Cloud Console via the Secrets panel in AI Studio.
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# TURN_CREDENTIALS_URL: URL of your deployed authenticated backend endpoint (Cloudflare Worker or Firebase Cloud Function)
# that requests short-lived temporary WebRTC TURN credentials from Cloudflare Realtime TURN.
TURN_CREDENTIALS_URL=YOUR_TURN_CREDENTIALS_URL
CLOUDFLARE_TURN_KEY_ID=YOUR_CLOUDFLARE_TURN_KEY_ID

# HEYGEN_API_KEY: Required for HeyGen LiveAvatar real-time streaming video tutor with synchronized lip-sync and facial expressions.
# Configure your HeyGen API key via the Secrets panel in AI Studio or the in-app Tutor Settings.
HEYGEN_API_KEY=YOUR_HEYGEN_API_KEY

# TAVUS_API_KEY: Optional alternative conversational replica video avatar provider.
# Configure your Tavus API key via the Secrets panel in AI Studio or the in-app Tutor Settings.
TAVUS_API_KEY=YOUR_TAVUS_API_KEY

# Optional static TURN fallback variables (commented out by default so AI Studio does not prompt for temporary TURN usernames/passwords):
# TURN_SERVER_URL=YOUR_TURN_SERVER_URL
# TURN_USERNAME=YOUR_TURN_USERNAME
# TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL

