    "CallRoom": {
      "title": "CallRoom",
      "description": "Real-time WebRTC voice and video call signaling room",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "callerNativeLang": { "type": "string" },
        "callerLearningLang": { "type": "string" },
        "calleeId": { "type": "string" },
        "calleeName": { "type": "string" },
        "calleeNativeLang": { "type": "string" },
        "calleeLearningLang": { "type": "string" },
        "callType": { "type": "string", "enum": ["voice", "video"] },
        "matchMode": { "type": "string", "enum": ["direct", "random", "country", "interest", "speaking_room"] },
        "targetLanguageCode": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["waiting", "ringing", "accepted", "connected", "ended", "rejected", "cancelled", "missed", "failed", "busy"]
        },
        "lastSignalingEvent": {
          "type": "string",
          "enum": [
            "call_initiated",
            "incoming_call",
            "call_ringing",
            "call_accepted",
            "call_rejected",
            "call_cancelled",
            "call_connected",
            "call_ended",
            "call_missed",
            "call_failed",
            "ice_candidate",
            "webrtc_offer",
            "webrtc_answer",
            "room_updated",
            "participant_joined",
            "participant_left"
          ]
        },
        "isCallerMuted": { "type": "boolean" },
        "isCalleeMuted": { "type": "boolean" },
        "isVideoEnabled": { "type": "boolean" },
        "isCallerVideoEnabled": { "type": "boolean" },
        "isCalleeVideoEnabled": { "type": "boolean" },
        "conversationTopic": { "type": "string" },
        "roomTitle": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "participantLimit": { "type": "integer" },
        "participantIds": { "type": "array" },
        "participantNames": { "type": "array" },
        "mutedParticipantIds": { "type": "array" },
        "handRaisedParticipantIds": { "type": "array" },
        "sdpOffer": { "type": "string" },
        "sdpAnswer": { "type": "string" },
        "callerIceCandidates": { "type": "array" },
        "calleeIceCandidates": { "type": "array" },
        "connectionState": {
          "type": "string",
          "enum": ["new", "checking", "connecting", "connected", "completed", "reconnecting", "disconnected", "failed", "closed"]
        },
        "connectedAtEpochMs": { "type": "integer" },
        "endedAtEpochMs": { "type": "integer" },
        "durationSeconds": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "roomId",
        "callerId",
        "callerName",
        "calleeId",
        "calleeName",
        "callType",
        "matchMode",
        "targetLanguageCode",
        "status",
        "isCallerMuted",
        "isCalleeMuted",
        "isVideoEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
