        "versionCode": { "type": "integer", "description": "Android versionCode of the published release" },
        "versionName": { "type": "string", "description": "Human-readable version string e.g. 29.0" },
        "title": { "type": "string", "description": "Update announcement heading" },
        "summary": { "type": "string", "description": "Update summary description" },
        "releaseNotes": { "type": "array", "description": "List of release note bullet items" },
        "isCritical": { "type": "boolean", "description": "Whether immediate update is required" },
        "minRequiredVersionCode": { "type": "integer", "description": "Minimum supported versionCode" },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["versionCode", "versionName", "title", "summary", "releaseNotes", "isCritical"]
    },
    "BookReadingProgress": {
      "title": "BookReadingProgress",
      "description": "Separate per-book reading position, chapter, page, and reader preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Google UID" },
        "bookId": { "type": "string", "description": "Unique book identifier" },
        "bookTitle": { "type": "string", "description": "Display title of the book" },
        "chapterIndex": { "type": "integer", "description": "Last read chapter index" },
        "scrollOffset": { "type": "integer", "description": "Last read paragraph or scroll index" },
        "pageIndex": { "type": "integer", "description": "Last read page index in paginated mode" },
        "progressPercent": { "type": "number", "description": "Overall reading completion 0.0 to 1.0" },
        "readingTheme": { "type": "string", "enum": ["LIGHT", "SEPIA", "DARK"] },
        "fontSizeSp": { "type": "number", "description": "Preferred reader font size in sp" },
        "isPageMode": { "type": "boolean", "description": "Whether paginated reader mode is enabled" },
        "completedChapters": { "type": "array", "description": "Chapter indices finished reading" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "bookId", "chapterIndex", "scrollOffset", "pageIndex", "progressPercent", "updatedAt"]
    },
    "BookListeningProgress": {
      "title": "BookListeningProgress",
      "description": "Separate per-book audiobook listening chapter, sentence, timestamp, and audio settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Google UID" },
        "bookId": { "type": "string", "description": "Unique book identifier" },
        "bookTitle": { "type": "string", "description": "Display title of the book" },
        "chapterIndex": { "type": "integer", "description": "Last listened chapter/episode index" },
        "sentenceIndex": { "type": "integer", "description": "Last listened sentence index" },
        "positionMs": { "type": "integer", "description": "Last audio playback position in milliseconds" },
        "progressPercent": { "type": "number", "description": "Overall listening completion 0.0 to 1.0" },
        "preferredEditionId": { "type": "string", "description": "Narrator preference (auto, librivox, tts)" },
        "autoPlayNextChapter": { "type": "boolean" },
        "isCompleted": { "type": "boolean" },
        "completedChapters": { "type": "array", "description": "Chapter indices finished listening" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "bookId", "chapterIndex", "sentenceIndex", "positionMs", "progressPercent", "updatedAt"]
    },
    "BookBookmark": {
      "title": "BookBookmark",
      "description": "User-saved bookmark within a book chapter for reading or listening",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Google UID" },
        "bookId": { "type": "string", "description": "Book identifier" },
        "bookTitle": { "type": "string", "description": "Book title" },
        "chapterIndex": { "type": "integer" },
        "chapterTitle": { "type": "string" },
        "sentenceIndex": { "type": "integer" },
        "positionMs": { "type": "integer" },
        "snippetText": { "type": "string" },
        "note": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "bookId", "bookTitle", "chapterIndex", "chapterTitle", "sentenceIndex", "positionMs", "snippetText", "updatedAt"]
    },
    "ExploreSession": {
      "title": "ExploreSession",
      "description": "Persisted AI learning session from LingoSphere Explore features",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "featureType": {
          "type": "string",
          "enum": ["living_immersion", "camera_lens", "emergency_pack", "ai_debate", "conversation_repair", "explain_three_ways", "conversation_detective", "mistake_recovery"]
        },
        "languageCode": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "cefrLevel": { "type": "string" },
        "turnsCount": { "type": "integer" },
        "scorePercent": { "type": "integer" },
        "payloadJson": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sessionId", "featureType", "languageCode", "title", "summary", "updatedAt"]
    },
    "MistakeRecord": {
      "title": "MistakeRecord",
      "description": "Learner mistake captured from speaking, roleplay, debate, immersion, camera lens, repair, or writing for spaced-repetition recovery",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "mistakeId": { "type": "string" },
        "languageCode": { "type": "string" },
        "languageName": { "type": "string" },
        "category": { "type": "string" },
        "originalResponse": { "type": "string" },
        "correctedVersion": { "type": "string" },
        "explanation": { "type": "string" },
        "activitySource": { "type": "string" },
        "reviewStatus": { "type": "string", "enum": ["pending", "practicing", "mastered"] },
        "occurrenceCount": { "type": "integer" },
        "masteryScore": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "mistakeId", "languageCode", "languageName", "category", "originalResponse", "correctedVersion", "explanation", "activitySource", "reviewStatus", "occurrenceCount", "masteryScore", "updatedAt"]
    }
  },
