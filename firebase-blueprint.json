      "required": [
        "userId",
        "wordId",
        "languageCode",
        "frontText",
        "backText",
        "pronunciation",
        "boxLevel",
        "nextReviewEpochDay",
        "mastered",
        "createdAt",
        "updatedAt"
      ]
    },
